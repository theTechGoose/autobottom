# Emulator-mode configuration. Loaded AFTER autobottom.env, so these win.
# Nothing here is a secret: every address these credentials would authenticate
# against is a loopback stand-in. Real AI keys still come from autobottom.env,
# because Groq / OpenAI / AssemblyAI are called live in both modes.
EMULATOR=true

# Firestore emulator. Same project id as prod so imported documents keep their
# exact paths.
FIREBASE_PROJECT_ID=keystone-fs97
FIREBASE_COLLECTION=autobottom
FIREBASE_DATABASE_ID=(default)
FIREBASE_SA_S3_KEY=credentials/firebase-sa.json

# Local S3. The bucket is a folder under fixtures/json/emulator/s3/.
S3_BUCKET=autobottom-emulator
AWS_S3_BUCKET=autobottom-emulator
AWS_ACCESS_KEY_ID=emulator
AWS_SECRET_ACCESS_KEY=emulator
AWS_REGION=us-east-1

# Prod's org id, so a snapshot pulled from prod imports unchanged.
DEFAULT_ORG_ID=b2e5e7ed-3885-4f2f-89b5-16fb77e090c0

# Tokens the stand-ins accept but never check.
QSTASH_TOKEN=emulator
POSTMARK_SERVER=emulator
QB_USER_TOKEN=emulator
QB_REALM=emulator
PINECONE_DB_KEY=emulator
ADAM_PINECONE=emulator

# Set so the tracked-link signature path actually runs; in prod this is a real
# secret and an unset one silently disables forgery checking.
TRACK_LINK_SECRET=emulator-track-secret

# Local app origin, so queue callbacks come back to your own server.
SELF_URL=http://127.0.0.1:3000
PORT=3000
